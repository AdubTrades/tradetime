# Copy to apps/server/.env.local (git-ignored) and fill in. Leave Supabase settings empty to run without sign-in.

# Supabase project URL (Project Settings → Data API). Turns sign-in on: every API request needs a Supabase token.
SUPABASE_URL=
# Only for older Supabase projects that still sign tokens with the legacy JWT secret. Usually leave empty.
SUPABASE_JWT_SECRET=

# Postgres connection string (Connect → Transaction pooler, port 6543). Empty = local PGlite in data-dev/pgdata.
DATABASE_URL=

# FRED API key for economic events (free from fred.stlouisfed.org), shared by everyone.
FRED_API_KEY=
