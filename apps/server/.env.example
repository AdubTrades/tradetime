# Copy to apps/server/.env.local (git-ignored) and fill in. Leave Supabase settings empty to run without sign-in.

# Supabase project URL (Project Settings → Data API). Turns sign-in on: every API request needs a Supabase token.
SUPABASE_URL=
# Publishable key (Project Settings → API Keys). With SUPABASE_URL, screenshots and receipts go to Supabase Storage.
SUPABASE_PUBLISHABLE_KEY=
# Only for scripts that run without a signed-in user (demo seed, data import). Never put this in the web app.
SUPABASE_SECRET_KEY=
# Per-user file storage cap in MB during the beta (default 100).
TC_STORAGE_CAP_MB=

# Only for older Supabase projects that still sign tokens with the legacy JWT secret. Usually leave empty.
SUPABASE_JWT_SECRET=

# Postgres connection string (Connect → Transaction pooler, port 6543). Empty = local PGlite in data-dev/pgdata.
DATABASE_URL=

# FRED API key for economic events (free from fred.stlouisfed.org), shared by everyone.
FRED_API_KEY=

# Web Push (notifications on any device). Generate once with: pnpm --filter @tc/server vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret that Supabase's scheduler sends to POST /api/jobs/tick (make one with: openssl rand -hex 32).
# Not needed locally: the server runs the same jobs itself every minute.
JOBS_SECRET=
