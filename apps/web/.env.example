# Copy to apps/web/.env.local (git-ignored) and fill in. Leave empty to run without sign-in.

# Supabase project URL and publishable key (Project Settings → API Keys). The publishable key is safe in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Sentry DSN for browser error reports (the same project as the server's SENTRY_DSN is fine).
VITE_SENTRY_DSN=
